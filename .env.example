# --- NODOS MIKROTIK (API PPPoE para migración BDCOM) ---
# Configura los nodos disponibles para seleccionar desde la UI.
# Formato: MIKROTIK_{N}_*
# Puerto API típico sin TLS: 8728
# Puerto API TLS (si aplica): 8729
MIKROTIK_1_NAME=Nodo-MK-1
MIKROTIK_1_IP=10.0.0.1
MIKROTIK_1_USER=api_user
MIKROTIK_1_PASSWORD=CAMBIAR_PASSWORD
MIKROTIK_1_PORT=8728

# MIKROTIK_2_NAME=Nodo-MK-2
# MIKROTIK_2_IP=10.0.0.2
# MIKROTIK_2_USER=api_user
# MIKROTIK_2_PASSWORD=CAMBIAR_PASSWORD
# MIKROTIK_2_PORT=8728

# --- MIGRACIÓN BDCOM (OVERRIDES POR MODELO) ---
# Formato: PREFIJO_MODELO=MODO, separados por coma
# MODO válido: ROUTER o BRIDGE
# Política sugerida:
# - ZTE siempre ROUTER.
# - Huawei / iConnect / Orange: base ROUTER y ajuste a BRIDGE por heurística MAC/vendor.
# - Ante duda: ROUTER.
MIGRATION_MODE_OVERRIDES=ZTE=ROUTER,F=ROUTER,HG=ROUTER,HS=ROUTER,EG=ROUTER,IC=ROUTER,OR=ROUTER,TX=ROUTER,XN=ROUTER

# --- HEURÍSTICA BRIDGE POR VENDOR DE MAC (opcional, eficiente) ---
# Estrategia SN-first:
# 1) Vendor ONU por primeras letras de SN (ej: ZTE, TPL, HWT)
# 2) Vendor por MAC (OUI/manuf)
# 3) Si hay inconsistencia SN vs MAC => BRIDGE
# 4) Si faltan datos: fallback a profile origen, override/modelo router, y default ROUTER.
ENABLE_MAC_VENDOR_BRIDGE_HEURISTIC=true
MAC_BRIDGE_VENDOR_KEYWORDS=TP-LINK,TPLINK,MERCUSYS
SN_VENDOR_PREFIX_MAP=ZTE=ZTE,TPL=TPLINK,HWT=HUAWEI
MAC_VENDOR_KEYWORD_MAP=ZTE=ZTE,HUAWEI=HUAWEI,TP-LINK=TPLINK,TPLINK=TPLINK,MERCUSYS=TPLINK,ICON=ICON,ORANGE=ORANGE
KNOWN_ROUTER_MODEL_PREFIXES=ZTE,F,HG,HS,EG,IC,OR,TX,XN
# Solo estos vendors ONU disparan BRIDGE cuando SN y MAC vendor son inconsistentes.
# ZTE queda excluido para mantener router-first en parque ZTE.
SN_MAC_MISMATCH_BRIDGE_SN_VENDORS=HUAWEI,ICON,ORANGE
# Modelos tratados como bridge puro por política operativa.
BRIDGE_ONLY_MODELS=EG8021V5,GP1704-2FC-S,GP1705-2G,IC425ETB,HG8310M,TX-6610,HG8010H,HG8240H
# Modelos mixtos donde se aplica validación adicional por vendor de MAC.
# Si la MAC no resuelve a HUAWEI => BRIDGE seguro (solo para estos modelos/prefijos).
HUAWEI_MAC_VALIDATION_MODEL_PREFIXES=EG8141A5,IC405WSG,HG8245H,HG8245H5,IC410WSG

# Mapeo opcional OUI->VENDOR para máxima precisión sin dependencias externas.
# Formato: OUI=VENDOR, separados por coma. OUI puede tener o no separadores.
# Ejemplo: MAC_OUI_VENDOR_OVERRIDES=F4F26D=TP-LINK,CC32E5=TP-LINK
# Ejemplo real Las Tapias (SN ZTE -> OUI ZTE):
# MAC_OUI_VENDOR_OVERRIDES=44A3C7=ZTE,E466AB=ZTE
MAC_OUI_VENDOR_OVERRIDES=

# Detección de vendor lógico por prefijo de ONT_MODEL (ordenado por prioridad)
ONT_VENDOR_PREFIXES=IC=ICON,OR=ORANGE,HG=HUAWEI,HS=HUAWEI,EG=HUAWEI,ZTE=ZTE,F=ZTE

# --- INYECCIÓN HUAWEI (PREPROVISIONAMIENTO) ---
# Parámetros leídos por config.py -> HUAWEI_INJECTION dict
# Ajustar según perfiles y tablas disponibles en la OLT Huawei
HUAWEI_VLAN_ID=700
HUAWEI_TRAFFIC_TABLE_UP=8
HUAWEI_TRAFFIC_TABLE_DOWN=9

# Mapeo de Perfiles por Modelo ONT (formato: MODEL:LINE_PROFILE:SERVICE_PROFILE)
# Sintaxis: MODELO1:prof_linea:prof_servicio,MODELO2:prof_linea:prof_servicio,...
# Ejemplos de modelos comunes:
#   - EG8021V5  (GPON ONT simple)
#   - EG8141A5  (GPON ONT estándar)
#   - HG8245H   (Huawei ONT doméstica)
#   - Generic fallback: line_profile 6, service_profile 3
HUAWEI_ONT_MODE_PROFILES=EG8141A5:1:1,EG8021V5:1:2,HG8245H:1:4,ZTE-F660:1:5,F670LV9.0:1:5,F6600PV9.0.05:1:5,HG8245H5:1:6,HG8310M:1:7,HG8545M:1:19,HG8546M:1:20,HS8145C:1:24,HS8145V:1:25,HS8545M5:1:26,HS8546V:1:27,IC405WSG:1:28,IC410WSG:1:29,IC425ETB:1:30,IC455WDB:1:31,TX-6610:1:32,XN020-G3:1:33,XC220-G3:1:33,XC220-G3V:1:33,F670L:1:37
HUAWEI_LINE_PROF_DEFAULT=1
HUAWEI_SRV_PROF_DEFAULT=3
# Si es true, se aborta la inyeccion cuando haya modelos sin mapeo explicito.
# Si es false, los no mapeados caen al perfil generico (srvprofile default).
HUAWEI_REQUIRE_EXPLICIT_MODEL_PROFILE=false
# Control operativo del runner de inyeccion Huawei
# Delay entre comandos dependientes (segundos)
HUAWEI_INJECTION_CMD_DELAY=0.4
# Reintentos maximos por comando frente a busy/timeouts
HUAWEI_INJECTION_MAX_RETRIES=10
# Seguridad operativa: abortar si el prompt remoto coincide con alguno de estos prefijos.
HUAWEI_INJECTION_FORBIDDEN_PROMPT_PREFIXES=VD2

# --- SMARTOLT API (MOVE ONU) ---
SMARTOLT_BASEURL=https://tu-subdominio.smartolt.com/api
SMARTOLT_TOKEN=tu_token_api
SMARTOLT_OLT_ID=1
SMARTOLT_TIMEOUT=20
SMARTOLT_RETRIES=3
SMARTOLT_RETRY_DELAY=1.0
SMARTOLT_MOVE_DELAY=0.2
